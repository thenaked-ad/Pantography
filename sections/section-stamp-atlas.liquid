    });

    /* DECLUTTER: greedy label collision — at each zoom step only labels
       that don't overlap an already-placed label are shown; more appear
       as you zoom in and space opens up */
    var _lastBucket = null, _shownLabels = {};
    function computeShownLabels(k) {
      var S = (svg.node().clientWidth || 1000) / W; /* css px per user unit at k=1 */
      var px = k * S;
      var placed = [];
      _shownLabels = {};
      var items = (root._saLocs || []).slice().sort(function (a, b) { return a._y - b._y || a._x - b._x; });
      items.forEach(function (p) {
        var w = p.title.length * 7 + 18;   /* label footprint in screen px */
        var h = 20;
        var ok = true;
        for (var i = 0; i < placed.length; i++) {
          var q = placed[i];
          if (Math.abs(p._x - q.x) * px < (w + q.w) / 2 && Math.abs(p._y - q.y) * px < h) { ok = false; break; }
        }
        if (ok) { placed.push({ x: p._x, y: p._y, w: w }); _shownLabels[p._key] = true; }
      });
    }
    function updateDetail(k) {
      g.selectAll('.sa-dot').attr('r', 2.6 / k);
      g.selectAll('.sa-ring').attr('opacity', k > 2.4 ? .9 : 0).attr('r', 6 / k).attr('stroke-width', 1 / k);
      if (k > 2.4) {
        var bucket = Math.round(k * 4) / 4;
        if (bucket !== _lastBucket) { computeShownLabels(k); _lastBucket = bucket; }
      }
      g.selectAll('.sa-label')
        .style('opacity', function (d) { return (k > 2.4 && _shownLabels[d._key]) ? 1 : 0; })
        .attr('font-size', (10.5 / k) + 'px')
        .attr('y', function (d) { return d._y - 9 / k; });
    }

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
  }

  /* ------------------------------------------------------------------ */
  function boot(scope) {
    (scope || document).querySelectorAll('[data-stamp-atlas]').forEach(function (el) {
      if (el.dataset.saInit) return;
      el.dataset.saInit = '1';
      prefetch(el); /* SPEED: world + catalogue start downloading right now */
      var start = function () {
        loadLibs().then(function () { initAtlas(el); }).catch(function () {
          /* one delayed retry — consent/chat scripts often release their
             grip on script injection a few seconds after page load */
          setTimeout(function () {
            loadLibs().then(function () { initAtlas(el); }).catch(function (e) {
              try { console.error('[Stamp Atlas] giving up:', e); } catch (x) {}
            });
          }, 3500);
        });
      };
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { io.disconnect(); start(); }
          });
        }, { rootMargin: '900px' }); /* SPEED: build well before it scrolls into view */
        io.observe(el);
      } else {
        start();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { boot(); });
  } else {
    boot();
  }
  /* re-init inside the Shopify theme editor */
  document.addEventListener('shopify:section:load', function (e) {
    if (e.target) {
      e.target.querySelectorAll('[data-stamp-atlas]').forEach(function (el) { delete el.dataset.saInit; });
      boot(e.target);
    }
  });
  /* re-init when the viewport crosses the mobile breakpoint (e.g. the
     theme editor's desktop/mobile toggle) so the right canvas is used */
  var resizeT;
  window.addEventListener('resize', function () {
    clearTimeout(resizeT);
    resizeT = setTimeout(function () {
      document.querySelectorAll('[data-stamp-atlas]').forEach(function (el) {
        if (!el.dataset.saInit || el._saMobile == null) return;
        var w = el.querySelector('[data-sa-map]');
        if (!w) return;
        var m = w.clientWidth > 0 && w.clientWidth < 640;
        if (m !== el._saMobile) loadLibs().then(function () { initAtlas(el); });
      });
    }, 350);
  });
})();

</script>

