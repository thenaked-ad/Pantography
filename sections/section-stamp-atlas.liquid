{% comment %}
  ============================================================
  STAMP ATLAS — interactive "browse artworks by location" map
  ------------------------------------------------------------
  Self-contained section. Files: this file + assets/stamp-atlas.css
  + assets/stamp-atlas.js. No other theme files are modified and
  no tracking/analytics code is touched.

  Products appear on the map when they have these metafields:
    custom.map_country  (single line text — e.g. "Spain")
    custom.map_lat      (decimal — optional, e.g. 37.39)
    custom.map_lng      (decimal — optional, e.g. -5.99)
  If lat/lng are left empty the pin falls back to the centre of
  the country. Products are read from the collection chosen in
  the section settings. Manual "Location" blocks can be used as
  an alternative to metafields.
  ============================================================
{% endcomment %}

{% comment %} map libraries vendored into theme assets — served from
   Shopify's CDN, no third-party scripts for consent managers to block {% endcomment %}
<link rel="preload" as="fetch" href="{{ 'sa-world-50m.json' | asset_url }}" crossorigin="anonymous">
<script src="{{ 'sa-d3.min.js' | asset_url }}" defer></script>
<script src="{{ 'sa-topojson.min.js' | asset_url }}" defer></script>
{% comment %} v3: CSS + JS inlined below — no separate asset files to cache or mismatch {% endcomment %}
<style>
/* STAMP ATLAS build v11 — 07 Jul 2026 */
/* ============================================================
   STAMP ATLAS — self-contained styles
   Added as a standalone Shopify section. Safe to remove:
   delete section-stamp-atlas.liquid, stamp-atlas.css, stamp-atlas.js.
   No other theme files are touched.
   ============================================================ */
.stamp-atlas{
  --sa-ink:#111111;
  --sa-line:#1a1a1a;
  --sa-paper:#ffffff;
  --sa-hover:#ececec;
  --sa-muted:#9a9a9a;
  --sa-hair:#e6e6e6;
  position:relative;
  max-width:1500px;
  margin:0 auto;
  padding-left:40px;
  padding-right:40px;
  color:var(--sa-ink);
  font-weight:300;
}
@media (max-width:760px){
  .stamp-atlas{padding-left:14px;padding-right:14px}
}
.stamp-atlas *,.stamp-atlas *::before,.stamp-atlas *::after{box-sizing:border-box}

/* THEME CONFLICT FIX (screen.css:481 + :2007): the Next theme paints every
   <button> via an absolutely-positioned ::before pseudo-element filled with
   --theme_bg_btn (#000). It paints OVER the button's own background, so no
   element-level styling can beat it. Kill the pseudo inside this feature. */
.stamp-atlas button::before,.stamp-atlas button::after,
.sa-panel button::before,.sa-panel button::after{
  content:none !important;display:none !important;
  background:none !important;border:0 !important;box-shadow:none !important;
}

/* THEME CONFLICT FIX #3 (screen.css: `*, ::before, ::after { transform-origin: center center }`):
   the theme re-bases EVERY transform around the element's centre, which
   silently re-maps all of d3's camera transforms (SVG expects origin 0 0).
   This single rule caused every "zooms to the bottom-right" symptom. */
.sa-mapwrap svg, .sa-mapwrap svg * { transform-origin: 0 0 !important; }

/* ---------- header ---------- */
.sa-head{text-align:center;margin-bottom:8px}
/* Desktop: sit the intro line level with the page title instead of 80px below it. */
@media (min-width:1100px){.stamp-atlas .sa-head{margin-top:-102px}}
.sa-eyebrow{font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:var(--sa-muted);margin:0 0 14px}
.sa-title{font-size:clamp(22px,3vw,34px);font-weight:300;letter-spacing:.18em;text-transform:uppercase;margin:0}
.sa-sub{margin:14px auto 0;font-size:13px;letter-spacing:.04em;color:#555;max-width:520px;line-height:1.6}

/* ---------- toolbar ---------- */
.sa-bar{display:flex;justify-content:center;align-items:center;gap:16px;margin:28px 0 6px;flex-wrap:wrap}
.sa-search{position:relative;width:min(340px,86vw)}
.sa-search input[type="text"]{
  width:100%;border:1px solid var(--sa-ink);background:transparent;
  font-family:inherit;font-weight:300;font-size:13px;letter-spacing:.14em;text-transform:uppercase;
  padding:11px 38px 11px 14px;outline:none;border-radius:0;color:var(--sa-ink);box-shadow:none;
}
.sa-search input::placeholder{color:#b5b5b5}
.sa-search svg{position:absolute;right:13px;top:50%;transform:translateY(-50%);pointer-events:none}
.sa-suggest{
  position:absolute;top:calc(100% - 1px);left:0;right:0;z-index:40;
  background:var(--sa-paper);border:1px solid var(--sa-ink);display:none;max-height:260px;overflow:auto;
}
.stamp-atlas .sa-suggest button{
  display:flex;justify-content:space-between;width:100% !important;min-width:0 !important;height:auto !important;
  text-align:left;background:none !important;border:0 !important;border-radius:0 !important;box-shadow:none !important;
  font-family:inherit !important;font-weight:300 !important;font-size:12px !important;
  letter-spacing:.14em !important;text-transform:uppercase !important;
  padding:11px 14px !important;cursor:pointer;color:var(--sa-ink) !important;line-height:1.4 !important;
}
.sa-suggest button span{color:var(--sa-muted);font-size:10px;letter-spacing:.2em}
.sa-suggest button:hover{background:var(--sa-hover)}
/* !important shields these controls from the theme's global button styles */
.stamp-atlas .sa-reset{
  border:1px solid var(--sa-ink) !important;background:transparent !important;color:var(--sa-ink) !important;
  font-family:inherit !important;font-weight:300 !important;font-size:12px !important;
  letter-spacing:.18em !important;text-transform:uppercase !important;
  padding:12px 22px !important;cursor:pointer;border-radius:0 !important;
  width:auto !important;min-width:0 !important;height:auto !important;min-height:0 !important;
  box-shadow:none !important;line-height:1.4 !important;
  transition:background .25s,color .25s;display:none;
}
.stamp-atlas .sa-reset:hover{background:var(--sa-ink) !important;color:#fff !important}

/* ---------- map stage ---------- */
.sa-stage{position:relative;margin-top:10px;overflow:hidden}
.sa-mapwrap{position:relative;width:100%;overflow:hidden;min-height:200px}
.sa-mapwrap svg{display:block;width:100%;height:auto;cursor:grab}
.sa-mapwrap svg:active{cursor:grabbing}
.sa-country{fill:var(--sa-paper);stroke:var(--sa-line);vector-effect:non-scaling-stroke;transition:fill .25s;cursor:pointer}
.sa-country.sa-has:hover{fill:var(--sa-hover)}
.sa-country.sa-none:hover{fill:#f7f7f7}
.sa-country.sa-selected,.sa-country.sa-selected:hover{fill:var(--sa-ink)}
.sa-country.sa-dim{opacity:.28}
.sa-dot{fill:var(--sa-ink);pointer-events:none}
.sa-dot.sa-inv{fill:#fff}
.sa-ring{fill:none;stroke:var(--sa-ink);pointer-events:none;opacity:0}
.sa-ring.sa-inv{stroke:#fff}
.sa-label{letter-spacing:.22em;text-transform:uppercase;fill:var(--sa-ink);pointer-events:none;opacity:0;transition:opacity .3s;font-family:inherit}
.sa-label.sa-inv{fill:#fff}
.sa-zoomctl{position:absolute;left:14px;bottom:14px;display:flex;flex-direction:column;z-index:10}
.stamp-atlas .sa-zoomctl button{
  width:36px !important;height:36px !important;min-width:0 !important;min-height:0 !important;
  border:1px solid var(--sa-ink) !important;background:var(--sa-paper) !important;color:var(--sa-ink) !important;
  font-size:17px !important;font-weight:300 !important;cursor:pointer;border-radius:0 !important;
  line-height:1 !important;font-family:inherit !important;padding:0 !important;margin:0 !important;
  letter-spacing:0 !important;box-shadow:none !important;display:flex;align-items:center;justify-content:center;
}
.stamp-atlas .sa-zoomctl button + button{border-top:0 !important}
.stamp-atlas .sa-zoomctl button:hover{background:var(--sa-ink) !important;color:#fff !important}
.sa-legend{
  position:absolute;right:14px;bottom:14px;z-index:10;display:flex;align-items:center;gap:8px;
  font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:#666;
  background:rgba(255,255,255,.85);padding:6px 10px;
}
.sa-legend i{width:5px;height:5px;border-radius:50%;background:var(--sa-ink);display:inline-block}
.sa-hint{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  pointer-events:none;opacity:0;transition:opacity .3s;z-index:15;
}
.sa-hint span{background:rgba(17,17,17,.82);color:#fff;font-size:10.5px;letter-spacing:.24em;text-transform:uppercase;padding:12px 20px}
.sa-tip{
  position:fixed;z-index:9999;pointer-events:none;background:#111;color:#fff;
  font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;padding:8px 12px;
  opacity:0;transform:translate(-50%,calc(-100% - 12px));white-space:nowrap;transition:opacity .15s;
}
.sa-tip small{display:block;color:#bdbdbd;font-size:9px;letter-spacing:.2em;margin-top:3px}

/* ---------- results panel ---------- */
.sa-panel{
  position:fixed;top:0;right:0;bottom:0;height:100vh;height:100dvh;
  width:min(390px,100%);z-index:10000;
  background:#ffffff;
  border-left:1px solid var(--sa-ink);
  transform:translateX(102%);visibility:hidden;
  transition:transform .45s cubic-bezier(.22,.8,.24,1),visibility 0s .45s;
  display:flex;flex-direction:column;
}
.sa-panel.sa-open{transform:translateX(0);visibility:visible;transition:transform .45s cubic-bezier(.22,.8,.24,1)}
.sa-panel-head{padding:26px 28px 20px;border-bottom:1px solid var(--sa-hair);display:flex;justify-content:space-between;align-items:flex-start}
.sa-place{font-size:17px;letter-spacing:.22em;text-transform:uppercase;font-weight:300;margin:0}
.sa-count{font-size:10px;letter-spacing:.26em;text-transform:uppercase;color:var(--sa-muted);margin:8px 0 0}
.sa-panel .sa-close{
  border:0 !important;background:none !important;cursor:pointer;font-size:20px !important;font-weight:300 !important;
  color:var(--sa-ink) !important;line-height:1 !important;padding:2px 4px !important;font-family:inherit !important;
  width:auto !important;min-width:0 !important;height:auto !important;min-height:0 !important;
  border-radius:0 !important;box-shadow:none !important;letter-spacing:0 !important;
}
.sa-body{flex:1;overflow-y:auto;overscroll-behavior:contain;padding:22px 28px 28px}
.sa-card{display:block;text-decoration:none;color:var(--sa-ink);margin-bottom:26px}
.sa-card-img{position:relative;background:#fff;border:1px solid var(--sa-hair);aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;overflow:hidden}
.sa-card-img img{width:100%;height:100%;object-fit:contain;transition:transform .6s ease}
.sa-card:hover .sa-card-img img{transform:scale(1.04)}
.sa-card-meta{display:flex;justify-content:space-between;align-items:baseline;margin-top:12px}
.sa-card-title{font-size:12.5px;letter-spacing:.2em;text-transform:uppercase}
.sa-card-price{font-size:12px;color:var(--sa-muted);letter-spacing:.06em}
.sa-card-cta{display:inline-block;margin-top:9px;font-size:10px;letter-spacing:.26em;text-transform:uppercase;border-bottom:1px solid var(--sa-ink);padding-bottom:3px}
.sa-stampph{
  width:74%;aspect-ratio:4/5;position:relative;background:#fff;border:1px solid #cfcfcf;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;
  -webkit-mask:radial-gradient(circle 5px at 5px 5px,transparent 4.5px,#000 5px) -5px -5px/14px 14px;
          mask:radial-gradient(circle 5px at 5px 5px,transparent 4.5px,#000 5px) -5px -5px/14px 14px;
  box-shadow:0 1px 14px rgba(0,0,0,.07);
}
.sa-stampph em{font-style:normal;font-size:9px;letter-spacing:.3em;color:#999;text-transform:uppercase}
.sa-stampph strong{font-weight:400;font-size:13px;letter-spacing:.24em;text-transform:uppercase;text-align:center;padding:0 12px}
.sa-stampph .sa-rule{width:34px;height:1px;background:#111}
.sa-empty{padding:8px 0}
.sa-empty p{font-size:13px;line-height:1.7;color:#444;letter-spacing:.03em;margin:0 0 22px}
.sa-empty a{
  display:inline-block;border:1px solid var(--sa-ink);color:var(--sa-ink);text-decoration:none;
  font-size:11px;letter-spacing:.2em;text-transform:uppercase;padding:12px 22px;margin:0 10px 10px 0;
  transition:background .25s,color .25s;
}
.sa-empty a:hover{background:var(--sa-ink);color:#fff}

/* ---------- mobile ---------- */
@media (max-width:760px){
  .sa-panel{
    position:fixed;top:auto;left:0;right:0;bottom:0;width:100%;height:62vh;
    border-left:0;border-top:1px solid var(--sa-ink);
    background:#ffffff !important;-webkit-backdrop-filter:none;backdrop-filter:none;
    transform:translateY(104%);
    padding-bottom:env(safe-area-inset-bottom); /* iPhone home indicator */
  }
  .sa-panel.sa-open{transform:translateY(0)}
  .sa-panel-head{padding:18px 20px 14px}
  .sa-body{padding:16px 20px 24px;display:flex;gap:14px;overflow-x:auto;overflow-y:hidden}
  .sa-card{min-width:62vw;margin-bottom:0}
  .sa-legend{display:none}
  .sa-zoomctl{left:auto;right:8px;bottom:8px}
  .stamp-atlas .sa-zoomctl button{width:32px !important;height:32px !important;font-size:15px !important}
}

</style>

{%- liquid
  assign pad_top = section.settings.padding_top | append: 'px'
  assign pad_bottom = section.settings.padding_bottom | append: 'px'
-%}

<div
  class="stamp-atlas"
  data-stamp-atlas
  data-empty-text="{{ section.settings.empty_text | escape }}"
  data-browse-url="{{ section.settings.browse_link | default: '/collections/all' }}"
  data-browse-label="{{ section.settings.browse_label | escape }}"
  data-request-email="{{ section.settings.request_email | escape }}"
  data-request-label="{{ section.settings.request_label | escape }}"
  {% if section.settings.collection != blank %}data-collection-url="{{ section.settings.collection.url }}"{% endif %}
  data-world-url="{{ 'sa-world-50m.json' | asset_url }}"
  style="padding-top:{{ pad_top }};padding-bottom:{{ pad_bottom }};"
>
  <header class="sa-head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="sa-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="sa-title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="sa-sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </header>

  <div class="sa-bar">
    {%- if section.settings.show_search -%}
      <div class="sa-search">
        <input type="text" data-sa-q placeholder="{{ section.settings.search_placeholder | default: 'Search a location' | escape }}" autocomplete="off" spellcheck="false" aria-label="Search a location">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.5-4.5"/></svg>
        <div class="sa-suggest" data-sa-suggest></div>
      </div>
    {%- endif -%}
    <button type="button" class="sa-reset" data-sa-reset>{{ section.settings.reset_label | default: 'View the world' }}</button>
  </div>

  <div class="sa-stage" style="margin-top:{{ section.settings.gap_search_map | default: 24 }}px">
    <div class="sa-mapwrap" data-sa-map>
      <div class="sa-zoomctl">
        <button type="button" data-sa-zin aria-label="Zoom in">+</button>
        <button type="button" data-sa-zout aria-label="Zoom out">&minus;</button>
      </div>
      {%- if section.settings.show_legend -%}
        <div class="sa-legend"><i></i> {{ section.settings.legend_label | default: 'Artwork available' }}</div>
      {%- endif -%}
      <div class="sa-hint" data-sa-hint><span>Pinch or ctrl + scroll to zoom</span></div>
    </div>

    <aside class="sa-panel" data-sa-panel aria-live="polite">
      <div class="sa-panel-head">
        <div>
          <h3 class="sa-place" data-sa-place></h3>
          <p class="sa-count" data-sa-count></p>
        </div>
        <button type="button" class="sa-close" data-sa-close aria-label="Close">&times;</button>
      </div>
      <div class="sa-body" data-sa-body></div>
    </aside>
  </div>

  {%- comment -%}
    Catalogue data. Collection products are fetched by stamp-atlas.js in
    pages of 250 via the collection.map alternate view (no Liquid loop cap).
    Manual "Location" blocks are inlined here.
  {%- endcomment -%}
  <script type="application/json" data-sa-data>
    [
      {%- assign first = true -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'location' and block.settings.product != blank and block.settings.country != blank -%}
          {%- assign bp = block.settings.product -%}
          {%- unless first -%},{%- endunless -%}
          {%- assign first = false -%}
          {
            "title": {% if block.settings.title != blank %}{{ block.settings.title | json }}{% else %}{{ bp.title | json }}{% endif %},
            "country": {{ block.settings.country | json }},
            "lat": {{ block.settings.lat | json }},
            "lng": {{ block.settings.lng | json }},
            "price": {% if bp.price_varies %}{{ bp.price_min | money | prepend: 'From ' | json }}{% else %}{{ bp.price_min | money | json }}{% endif %},
            "url": {{ bp.url | json }},
            "img": {% if bp.featured_image %}{{ bp.featured_image | image_url: width: 600 | json }}{% else %}null{% endif %}
          }
        {%- endif -%}
      {%- endfor -%}
    ]
  </script>
</div>

<script>
/* STAMP ATLAS build v11 — 07 Jul 2026 */
/* ============================================================
   STAMP ATLAS — self-contained interactive map
   - No dependencies on other theme JS. No globals except window.d3
     / window.topojson (loaded lazily, only when this section is
     scrolled into view, so site performance is unaffected).
   - Does not touch tracking, analytics or any third-party code.
   - Safe to remove together with section-stamp-atlas.liquid
     and stamp-atlas.css.
   ============================================================ */
(function () {
  'use strict';
  try { console.log('[Stamp Atlas] build v11'); } catch (e) {}

  var D3_SRCS   = ['https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js', 'https://unpkg.com/d3@7/dist/d3.min.js'];
  var TOPO_SRCS = ['https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js', 'https://unpkg.com/topojson-client@3/dist/topojson-client.min.js'];
  /* 50m resolution so small nations & territories (St. Barts, Montserrat,
     Monaco, Anguilla, …) exist as selectable shapes. Lazy-loaded on scroll. */
  var WORLD_SRC = 'https://cdn.jsdelivr.net/npm/world-atlas@2/countries-50m.json';
  var WORLD_ALT = 'https://unpkg.com/world-atlas@2/countries-50m.json';

  /* Map common spellings to the country names used by the world atlas */
  var ALIAS = {
    'usa':'United States of America','us':'United States of America','united states':'United States of America','america':'United States of America',
    'uk':'United Kingdom','great britain':'United Kingdom','england':'United Kingdom','scotland':'United Kingdom','wales':'United Kingdom','northern ireland':'United Kingdom',
    'uae':'United Arab Emirates',
    'czech republic':'Czechia',
    'ivory coast':"Côte d'Ivoire",'cote divoire':"Côte d'Ivoire","cote d'ivoire":"Côte d'Ivoire",
    'democratic republic of the congo':'Dem. Rep. Congo','democratic republic of congo':'Dem. Rep. Congo','drc':'Dem. Rep. Congo',
    'republic of the congo':'Congo','congo brazzaville':'Congo',
    'central african republic':'Central African Rep.',
    'south sudan':'S. Sudan',
    'bosnia and herzegovina':'Bosnia and Herz.','bosnia':'Bosnia and Herz.',
    'dominican republic':'Dominican Rep.',
    'equatorial guinea':'Eq. Guinea',
    'solomon islands':'Solomon Is.',
    'east timor':'Timor-Leste',
    'western sahara':'W. Sahara',
    'burma':'Myanmar','myanmar (burma)':'Myanmar',
    'swaziland':'eSwatini','eswatini':'eSwatini',
    'north macedonia':'Macedonia','macedonia':'Macedonia',
    'falkland islands':'Falkland Is.',
    'turkey':'Turkey','turkiye':'Turkey','türkiye':'Turkey',
    'holland':'Netherlands',
    'cape verde':'Cabo Verde',
    'faroe islands':'Faeroe Is.',
    'st. barts':'St-Barthélemy','st barts':'St-Barthélemy','saint barthelemy':'St-Barthélemy',
    'antigua':'Antigua and Barb.','antigua and barbuda':'Antigua and Barb.',
    'st. kitts':'St. Kitts and Nevis','st kitts':'St. Kitts and Nevis','st kitts and nevis':'St. Kitts and Nevis',
    'st. lucia':'Saint Lucia','st lucia':'Saint Lucia',
    'st. vincent':'St. Vin. and Gren.','st vincent':'St. Vin. and Gren.','st vincent and the grenadines':'St. Vin. and Gren.',
    'cayman islands':'Cayman Is.',
    'turks and caicos':'Turks and Caicos Is.','turks & caicos':'Turks and Caicos Is.',
    'british virgin islands':'British Virgin Is.','bvi':'British Virgin Is.',
    'trinidad & tobago':'Trinidad and Tobago',
    'french polynesia':'Fr. Polynesia',
    'macau':'Macao',
    'vatican city':'Vatican',
    'korea':'South Korea',
    'guyana':'Guyana','british guiana':'Guyana',
    'papua new guinea':'Papua New Guinea','new guinea':'Papua New Guinea'
  };

  /* Hardened loader: some storefront scripts (consent managers, chat
     widgets) intercept dynamically-added script tags, so a single attempt
     can hang forever. Attempts time out, retry, fall back to a second CDN,
     poll for the expected global, and never cache a failure. */
  function loadOnce(src) {
    return new Promise(function (resolve, reject) {
      var s = document.createElement('script');
      var done = false;
      s.src = src; s.async = true;
      s.onload = function () { if (!done) { done = true; resolve(); } };
      s.onerror = function () { if (!done) { done = true; reject(new Error('failed: ' + src)); } };
      document.head.appendChild(s);
      setTimeout(function () { if (!done) { done = true; reject(new Error('timeout: ' + src)); } }, 9000);
    });
  }
  function ensureGlobal(name, sources) {
    return new Promise(function (resolve, reject) {
      var i = 0;
      function attempt() {
        if (window[name]) return resolve();
        if (i >= sources.length) return reject(new Error('[Stamp Atlas] could not load ' + name));
        var src = sources[i++];
        loadOnce(src).then(pollGlobal, attempt);
      }
      function pollGlobal() {
        var t0 = Date.now();
        (function poll() {
          if (window[name]) return resolve();
          if (Date.now() - t0 > 2500) return attempt();
          setTimeout(poll, 100);
        })();
      }
      attempt();
    });
  }
  var libsPromise = null;
  function loadLibs() {
    if (!libsPromise) {
      libsPromise = ensureGlobal('d3', D3_SRCS)
        .then(function () { return ensureGlobal('topojson', TOPO_SRCS); });
      libsPromise.catch(function (e) {
        libsPromise = null; /* don't cache failures — allow retry */
        try { console.error('[Stamp Atlas] library load failed, will retry on next trigger', e); } catch (x) {}
      });
    }
    return libsPromise;
  }

  /* ------------------------------------------------------------------ */
  /* SPEED: data fetching is separated from map building so it can start
     at page load (see prefetch() in boot) instead of on-scroll */
  function inlineData(root) {
