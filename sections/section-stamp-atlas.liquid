    var zBtnBase = {
      'background': '#ffffff', 'color': '#111111', 'border': '1px solid #111111',
      'border-radius': '0', 'box-shadow': 'none', 'width': isMobile ? '32px' : '36px',
      'height': isMobile ? '32px' : '36px', 'min-width': '0', 'min-height': '0',
      'padding': '0', 'line-height': '1', 'font-size': isMobile ? '15px' : '17px',
      'letter-spacing': '0', 'text-transform': 'none', 'font-weight': '300'
