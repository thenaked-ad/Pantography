      var TERRITORIES = [
        { name: 'Martinique',    parent: 'France',      bbox: [-61.5, 14.2, -60.6, 15.1] },
        { name: 'Guadeloupe',    parent: 'France',      bbox: [-62.0, 15.7, -60.9, 16.7] },
        { name: 'French Guiana', parent: 'France',      bbox: [-55.5,  1.8, -51.0,  6.2] },
        { name: 'Réunion',       parent: 'France',      bbox: [ 54.9, -21.6, 56.1, -20.6] },
