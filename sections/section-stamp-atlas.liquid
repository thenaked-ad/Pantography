  "settings": [
    {
      "type": "paragraph",
      "content": "Products appear on the map when they have the metafields custom.map_country (required), custom.map_lat and custom.map_lng (optional — pin falls back to the centre of the country). Choose the collection to read products from below, or add manual Location blocks."
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (small line above heading)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Stamp Atlas" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "An artwork from every country in the world. Select a location to explore the artworks available from that part of the map." },
    { "type": "collection", "id": "collection", "label": "Collection with mapped products" },
    { "type": "header", "content": "Map options" },
    { "type": "checkbox", "id": "show_search", "label": "Show location search", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search a location" },
    { "type": "checkbox", "id": "show_legend", "label": "Show legend", "default": true },
    { "type": "text", "id": "legend_label", "label": "Legend label", "default": "Artwork available" },
    { "type": "text", "id": "reset_label", "label": "Reset button label", "default": "View the world" },
    { "type": "range", "id": "gap_search_map", "label": "Space between search bar and map", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "header", "content": "Empty state (countries without artworks)" },
    { "type": "textarea", "id": "empty_text", "label": "Text ({location} is replaced by the country name)", "default": "The aim of the project is to produce an artwork from every country in the world — {location} is still to come." },
    { "type": "url", "id": "browse_link", "label": "Browse all link" },
    { "type": "text", "id": "browse_label", "label": "Browse all label", "default": "View all artworks" },
    { "type": "text", "id": "request_email", "label": "Request email (leave blank to hide)", "default": "studio@pantography.com" },
    { "type": "text", "id": "request_label", "label": "Request button label", "default": "Request this location" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
