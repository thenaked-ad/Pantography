        { "type": "text", "id": "country", "label": "Country (e.g. Spain)" },
        { "type": "text", "id": "lat", "label": "Latitude (optional)" },
        { "type": "text", "id": "lng", "label": "Longitude (optional)" }
      ]
    }
  ],
  "presets": [
    { "name": "Stamp Atlas map" }
  ]
}
