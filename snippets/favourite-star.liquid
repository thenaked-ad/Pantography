{%- comment -%}
  Favourite heart for one artwork. assets/favourites.js saves the list in the
  browser (shared with the miniatures builder's starred artworks) and keeps
  every heart for the same handle in step.
  Accepts:
  - product: {Object}
  - class: {String} 'fav-star--card' beside a card's title, 'fav-star--inline' beside a product title
{%- endcomment -%}
<button
  type="button"
  class="fav-star{% if class != blank %} {{ class }}{% endif %}"
  data-fav="{{ product.handle }}"
  data-fav-title="{{ product.title | escape }}"
  aria-pressed="false"
  aria-label="Add {{ product.title | escape }} to favourites"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.3s-7.6-4.7-9.4-9.3C1.4 7.8 3.5 4.3 7 4.3c2.1 0 3.6 1.2 5 3 1.4-1.8 2.9-3 5-3 3.5 0 5.6 3.5 4.4 6.7-1.8 4.6-9.4 9.3-9.4 9.3z"/></svg>
</button>
