{% liquid
  assign search_collection = section.settings.collection
  if search_collection == blank and collection != blank
    assign search_collection = collection
  endif
%}

{% if search_collection != blank %}
  {%- comment -%}
    Matches the z-index the live theme gives the old search section, so the
    collection list below (pulled up 80px, opaque overlay) cannot cover the field.
  {%- endcomment -%}
  <style>
    #shopify-section-{{ section.id }} {
      position: relative;
      z-index: 25;
    }
  </style>

  <collection-product-search
    class="collection-search"
    style="
      --collection-search-background: {{ section.settings.background_color }};
      --collection-search-text: {{ section.settings.text_color }};
      --collection-search-accent: {{ section.settings.accent_color }};
      --collection-search-card-background: {{ section.settings.card_background_color }};
      --collection-search-columns: {{ section.settings.columns_desktop }};
      --collection-search-max-width: {{ section.settings.max_width }}px;
    "
    data-section-id="{{ section.id }}"
    data-collection-url="{{ search_collection.url }}"
    data-min-characters="{{ section.settings.minimum_characters }}"
    data-loading-text="{{ section.settings.loading_text | escape }}"
    data-error-text="{{ section.settings.error_text | escape }}"
    data-prompt-text="{{ section.settings.prompt_text | escape }}"
    data-one-result-text="{{ section.settings.one_result_text | escape }}"
    data-many-results-text="{{ section.settings.many_results_text | escape }}"
    data-no-results-text="{{ section.settings.no_results_text | escape }}"
    data-show-vendor="{{ section.settings.show_vendor }}"
    data-show-price="{{ section.settings.show_price }}"
    data-replace-original-grid="{{ section.settings.replace_original_grid }}"
    data-original-grid-selector="{{ section.settings.original_grid_selector | escape }}"
    data-index-fallback="{{ section.settings.index_fallback }}"
    data-index-view="{{ section.settings.index_view | escape }}"
    data-index-max="{{ section.settings.index_max }}"
    data-index-text="{{ section.settings.index_results_text | escape }}"
  >
    <div class="collection-search__inner">
      {% if section.settings.heading != blank %}
        <h2 class="collection-search__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      <form class="collection-search__form" role="search">
        <input
          id="CollectionSearch-{{ section.id }}"
          class="collection-search__input"
          type="text"
          autocomplete="off"
          aria-label="{{ section.settings.placeholder | escape }}"
          placeholder="{{ section.settings.placeholder | escape }}"
        >
        <span class="collection-search__icon" aria-hidden="true">🔍</span>
      </form>

      <p class="collection-search__status" data-search-status aria-live="polite"></p>
      <div class="collection-search__grid" data-search-results hidden></div>
    </div>

    {% paginate search_collection.products by 50 %}
      <script type="application/json" data-collection-search-page>
        {
          "page": {{ paginate.current_page | json }},
          "pages": {{ paginate.pages | json }},
          "products": [
            {% for product in search_collection.products %}
              {% capture searchable_text %}
                {{ product.title }} {{ product.vendor }} {{ product.type }}
                {% for tag in product.tags %} {{ tag }}{% endfor %}
                {% for variant in product.variants %} {{ variant.sku }} {{ variant.barcode }}{% endfor %}
              {% endcapture %}
              {% capture display_price %}
                {% if product.price_varies %}{{ section.settings.from_text }} {% endif %}{{ product.price | money }}
              {% endcapture %}
              {
                "id": {{ product.id | json }},
                "title": {{ product.title | json }},
                "url": {{ product.url | json }},
                "vendor": {{ product.vendor | json }},
                "price": {{ display_price | strip | json }},
                "search": {{ searchable_text | strip_html | strip_newlines | json }},
                "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 720 | json }}{% else %}null{% endif %},
                "image_alt": {{ product.featured_image.alt | default: product.title | json }}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        }
      </script>
    {% endpaginate %}
  </collection-product-search>

  <script src="{{ 'collection-search.js' | asset_url }}" defer></script>
{% endif %}

{% stylesheet %}
  .collection-search {
    display: block;
    position: relative;
    z-index: 33;
    background: var(--collection-search-background);
    color: var(--collection-search-text);
    padding: 0;
  }

  .collection-search__inner {
    width: 100%;
    max-width: var(--collection-search-max-width);
    margin: 0 auto;
  }

  .collection-search__heading {
    margin: 0 0 20px;
    color: inherit;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.2;
    text-align: center;
  }

  .collection-search__form {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    margin: 0;
  }

  .collection-search__input {
    width: 100%;
    padding: 10px 35px 10px 10px;
    border: 1px solid #ddd;
    border-radius: 0;
    outline: none;
  }

  .collection-search__icon {
    position: absolute;
    right: 10px;
    font-size: 16px;
    line-height: 1;
    color: #666;
    pointer-events: none;
  }

  .collection-search__status {
    min-height: 24px;
    margin: 16px 0;
    text-align: center;
  }

  .collection-search__grid {
    display: grid;
    grid-template-columns: repeat(var(--collection-search-columns), minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 40px;
  }

  .collection-search__card {
    overflow: hidden;
    border-radius: 8px;
    background: var(--collection-search-card-background);
    color: var(--collection-search-text);
  }

  .collection-search__card-link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .collection-search__image-wrap {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: color-mix(in srgb, var(--collection-search-text) 5%, transparent);
  }

  .collection-search__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 180ms ease;
  }

  .collection-search__card-link:hover .collection-search__image {
    transform: scale(1.03);
  }

  .collection-search__card-body {
    display: block;
    padding: 16px;
  }

  .collection-search__vendor {
    display: block;
    margin-bottom: 4px;
    font-size: 0.8rem;
    opacity: 0.7;
  }

  .collection-search__product-title {
    display: block;
    font-weight: 600;
    line-height: 1.35;
  }

  .collection-search__price {
    display: block;
    margin-top: 8px;
  }

  @media (max-width: 989px) {
    .collection-search__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }
  }

  @media (max-width: 749px) {
    .collection-search {
      padding: 0;
    }

    .collection-search__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection search",
  "tag": "section",
  "class": "section-collection-search",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave blank to use the collection for the current page."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Search this collection"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Enter a product name, SKU or keyword"
    },
    {
      "type": "checkbox",
      "id": "index_fallback",
      "label": "Fall back to Shopify search",
      "info": "When a term matches nothing in this collection's own text, use Shopify's search ranking and keep only the products in this collection. Covers visual terms such as colours.",
      "default": true
    },
    {
      "type": "text",
      "id": "index_view",
      "label": "Relevance feed view",
      "info": "Alternate search template used for the fallback. Leave as rank unless the template is renamed.",
      "default": "rank"
    },
    {
      "type": "range",
      "id": "index_max",
      "label": "Maximum fallback results",
      "min": 12,
      "max": 96,
      "step": 12,
      "default": 48
    },
    {
      "type": "text",
      "id": "index_results_text",
      "label": "Fallback results message",
      "default": "Closest matches for [term]"
    },
    {
      "type": "range",
      "id": "minimum_characters",
      "label": "Minimum search characters",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Loading message",
      "default": "Searching the collection…"
    },
    {
      "type": "text",
      "id": "prompt_text",
      "label": "Minimum characters message",
      "info": "Use [count] where the number should appear.",
      "default": "Enter at least [count] characters."
    },
    {
      "type": "text",
      "id": "one_result_text",
      "label": "One result message",
      "default": "1 result"
    },
    {
      "type": "text",
      "id": "many_results_text",
      "label": "Multiple results message",
      "info": "Use [count] where the number should appear.",
      "default": "[count] results"
    },
    {
      "type": "text",
      "id": "no_results_text",
      "label": "No results message",
      "default": "No matching products found in this collection."
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Error message",
      "default": "The collection could not be searched. Please try again."
    },
    {
      "type": "text",
      "id": "from_text",
      "label": "Variable price prefix",
      "default": "From"
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 900,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Existing collection grid"
    },
    {
      "type": "checkbox",
      "id": "replace_original_grid",
      "label": "Hide original grid while searching",
      "default": true
    },
    {
      "type": "text",
      "id": "original_grid_selector",
      "label": "Original grid CSS selector",
      "info": "The default works with Dawn and many Dawn-based themes. Change it if your theme uses different grid classes.",
      "default": "#product-grid, .pagination-wrapper"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Focus accent",
      "default": "#1f1f1f"
    }
  ],
  "presets": [
    {
      "name": "Collection search"
    }
  ]
}
{% endschema %}
