      if (isMobile) {
        var k0 = Math.max(1, Math.min(3, H / (EXT[1][1] - EXT[0][1])));
        zoom.scaleExtent([k0, 80]);
        homeT = clampT(k0, projection([10, 30])[0], (EXT[0][1] + EXT[1][1]) / 2);
