{%- comment -%}
  Favourite star for one artwork. assets/favourites.js saves the list in the
  browser (shared with the miniatures builder's starred artworks) and keeps
  every star for the same handle in step.
  Accepts:
  - product: {Object}
  - class: {String} extra class, e.g. 'fav-star--inline' beside a product title
{%- endcomment -%}
<button
  type="button"
  class="fav-star{% if class != blank %} {{ class }}{% endif %}"
  data-fav="{{ product.handle }}"
  data-fav-title="{{ product.title | escape }}"
  aria-pressed="false"
  aria-label="Add {{ product.title | escape }} to favourites"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3.2l2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 17l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8z"/></svg>
</button>
