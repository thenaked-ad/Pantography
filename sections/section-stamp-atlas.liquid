    imp((panel || root).querySelector('[data-sa-close]'), {
      'background': 'none', 'color': '#111111', 'border': '0', 'border-radius': '0',
      'box-shadow': 'none', 'padding': '2px 4px', 'width': 'auto', 'min-width': '0',
      'height': 'auto', 'min-height': '0', 'font-size': '20px', 'line-height': '1',
      'letter-spacing': '0'
    });

    root._saMobile = isMobile;
    /* square canvas on mobile: bigger map, pan sideways like a map app */
    var W = 1420, H = isMobile ? 1420 : 700;
    var svg = d3.select(wrap).insert('svg', ':first-child')
      .attr('viewBox', '0 0 ' + W + ' ' + H)
