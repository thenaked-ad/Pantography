            data.resources.results.products.forEach(product => {\n                    resultsHtml += `<div class=\"predictive-result\">\n                        <a href=\"${product.url}\">\n                            <img src=\"${product.image}\" alt=\"${product.title}\" width=\"50\">\n                            <span>${product.title}<\/span>\n                        <\/a>\n                    <\/div>`;\n                });\n\n                resultsContainer.innerHTML = resultsHtml;\n            })\n            .catch(error => console.error(\"Search error:\", error));\n    });\n\n    \/\/ Handle Enter key to go to full search results\n    searchInput.addEventListener(\"keypress\", function(event) {\n        if (event.key === \"Enter\") {\n            event.preventDefault();\n            searchForm.submit();\n        }\n    });\n\n    \/\/ Clicking the search icon submits the form\n    searchIcon.addEventListener(\"click\", function() {\n        searchForm.submit();\n    });\n});\n<\/script>","enable_darkmode":"off","sections":{"main-account":{"type":"main-account","settings":{"overlay_opacity":25,"color_palette":"dark","image_position":"center center","image_position_mobile":"center center","text_position":"text-start","show_phone_link":true,"show_mail_link":true,"show_whatsapp_link":true}},"main-account-login":{"type":"main-account-login","blocks":{"main-account-login-block-usp-1":{"type":"usp","settings":{}}},"block_order":["main-account-login-block-usp-1"],"settings":{}},"main-account-register":{"type":"main-account-register","settings":{}},"main-giftcard":{"type":"main-giftcard","settings":{"show_logo":false,"logo_width":250,"show_logo_giftcard":true,"logo_width_on_giftcard":165,"giftcard_background_color":"#0e1320","giftcard_text_color":"#ffffff"}},"sticky-add-to-cart":{"type":"sticky-add-to-cart","settings":{"enable":false,"position":"bottom","color_palette":"white","button_color_style":"buy_button plain","show_variant_picker":true,"show_unavailable_variant