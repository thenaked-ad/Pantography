      g.selectAll('path.sa-country')
        .data(countries)
        .join('path')
        .attr('class', function (d) { return 'sa-country ' + (byCountry[d.properties.name] ? 'sa-has' : 'sa-none'); })
        .attr('d', path)
        .attr('stroke-width', .7)
        .on('mousemove', function (ev, d) {
          var list = byCountry[d.properties.name];
          tip.innerHTML = d.properties.name +
            (list ? '<small>' + list.length + ' artwork' + (list.length > 1 ? 's' : '') + ' — view</small>'
