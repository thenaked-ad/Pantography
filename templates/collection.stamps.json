{"sections":{"section_custom_liquid_rpcnAR":{"type":"section-custom-liquid","name":"t:sections.custom_liquid.presets.name","settings":{"custom_liquid":"<style>\n  .collection-top-tabs {\n    --black: #111111;\n    --grey: #d9d9d9;\n    --text: #111111;\n    --muted: #9b9b9b;\n    --bg: #ffffff;\n    --bw: 1px;\n    --inactive-top-inset: 6px;\n    --inactive-side-inset: 6px;\n    margin: 0 0 24px;\n    background: var(--bg);\n  }\n\n  .collection-top-tabs * {\n    box-sizing: border-box;\n  }\n\n  .collection-top-tabs__inner {\n    display: flex;\n    width: 100%;\n    align-items: stretch;\n  }\n\n  .collection-top-tabs__tab {\n    position: relative;\n    flex: 1 1 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 56px;\n    padding: 18px 18px 12px;\n    text-decoration: none;\n    text-transform: uppercase;\n    letter-spacing: 0.4em;\n    line-height: 1;\n    font-size: 16px;\n    background: var(--bg);\n    color: var(--muted);\n    white-space: nowrap;\n    transition: color 0.2s ease, font-weight 0.2s ease;\n  }\n\n  .collection-top-tabs__label {\n    display: block;\n    width: 100%;\n    text-align: center;\n    position: relative;\n    z-index: 2;\n  }\n\n  .collection-top-tabs__tab:hover {\n    color: var(--text);\n    font-weight: 700;\n  }\n\n  .collection-top-tabs__tab:focus-visible {\n    outline: 2px solid var(--black);\n    outline-offset: 2px;\n    z-index: 3;\n  }\n\n  .collection-top-tabs__tab.is-active {\n    color: var(--text);\n    font-weight: 700;\n    z-index: 2;\n  }\n\n  \/* ACTIVE LEFT TAB *\/\n  .collection-top-tabs__tab--left.is-active {\n    border-top: var(--bw) solid var(--black);\n    border-left: var(--bw) solid var(--black);\n    border-right: 0;\n    border-bottom: 0;\n  }\n\n  \/* INACTIVE RIGHT TAB *\/\n  .collection-top-tabs__tab--right {\n    border-left: var(--bw) solid var(--black);   \/* middle divider *\/\n    border-bottom: var(--bw) solid var(--black); \/* dark bottom line stays full width *\/\n    border-top: 0;\n    border-right: 0;\n  }\n\n  .collection-top-tabs__tab--right::before {\n    content: \"\";\n    position: absolute;\n    top: var(--inactive-top-inset);\n    left: 0;\n    right: var(--inactive-side-inset);\n    bottom: 0;\n    border-top: var(--bw) solid var(--grey);\n    border-right: var(--bw) solid var(--grey);\n    pointer-events: none;\n    z-index: 1;\n  }\n\n  @media screen and (max-width: 749px) {\n    .collection-top-tabs {\n      --inactive-top-inset: 6px;\n      --inactive-side-inset: 6px;\n    }\n\n    .collection-top-tabs__tab {\n      min-height: 56px;\n      padding: 12px 10px 10px;\n      font-size: 14px;\n      letter-spacing: 0.4em;\n    }\n  }\n\n  @media screen and (max-width: 480px) {\n    .collection-top-tabs {\n      --inactive-top-inset: 6px;\n      --inactive-side-inset: 6px;\n    }\n\n    .collection-top-tabs__tab {\n      min-height: 50px;\n      padding: 10px 8px;\n      font-size: 12px;\n    }\n  }\n.collection-top-tabs__tab:not(.is-active) .collection-top-tabs__label {\n  display: inline-block;\n  transform: translateY(3px);\n}\n<\/style>\n\n<div class=\"collection-top-tabs\">\n  <div class=\"collection-top-tabs__inner\">\n    <a href=\"\/collections\/most-popular\" class=\"collection-top-tabs__tab collection-top-tabs__tab--left is-active\">\n      <span class=\"collection-top-tabs__label\">Floating<\/span>\n    <\/a>\n\n    <a href=\"\/collections\/flat-prints-most-popular\" class=\"collection-top-tabs__tab collection-top-tabs__tab--right\">\n      <span class=\"collection-top-tabs__label\">Flat<\/span>\n    <\/a>\n  <\/div>\n<\/div>","spacing_desktop":50,"spacing_mobile":30,"fix_zindex":0}},"section_custom_liquid_wnezqT":{"type":"section-custom-liquid","disabled":true,"name":"t:sections.custom_liquid.presets.name","settings":{"custom_liquid":"<div class=\"linked-grid\">\n  <a href=\"\/collections\/most-popular\" class=\"linked-grid__item linked-grid__item--active\">\n    <h2>FLOATING<\/h2>\n  <\/a>\n\n  <a href=\"\/collections\/flat-prints-most-popular\" class=\"linked-grid__item\">\n    <h2>FLAT<\/h2>\n  <\/a>\n<\/div>","spacing_desktop":50,"spacing_mobile":30,"fix_zindex":0}},"breadcrumbs":{"type":"breadcrumbs","disabled":true,"settings":{"hide_mobile":false,"back_button":false}},"section_custom_html_X8KqAE":{"type":"section-custom-html","disabled":true,"settings":{"custom_html":"<center>\n<h5>IMPORTANT INFORMATION<\/h5>\n<p>Print runs are limited to 100, 75, 10 and available in 3 sizes.  If you looking for a stamp from a specific country, please get in touch. Due to all works being made to order, we do not accept refunds, only exchanges. In which case, we ask the customer pays for the return delivery. Turnaround time for the artwork is currently two weeks. Free collection from our studio in Battersea is available at checkout. Please note that collection can take up to two weeks.<\/p>\n<\/center>","spacing_desktop":50,"spacing_mobile":30,"fix_zindex":0}},"section_custom_html_fUGQwj":{"type":"section-custom-html","custom_css":[],"settings":{"custom_html":"<div class=\"sticky-search-wrapper\">\n<form id=\"collection-search-form\" action=\"\/search\" method=\"get\">\n    <div class=\"search-container\">\n        <input type=\"text\" id=\"collection-search-input\" name=\"q\" placeholder=\"Search\" autocomplete=\"off\">\n        <span id=\"search-icon\">🔍<\/span> <!-- Just the icon, no button -->\n    <\/div>\n    <div id=\"predictive-results\"><\/div>\n<\/form>\n<\/div>","spacing_desktop":0,"spacing_mobile":0,"fix_zindex":25}},"section_custom_liquid_Tch3UH":{"type":"section-custom-liquid","name":"t:sections.custom_liquid.presets.name","settings":{"custom_liquid":"<!-- MOBILE SORT DROPDOWN (Shopify Next) -->\n<div class=\"mobile-sort\" data-mobile-sort>\n  <label class=\"mobile-sort__label\" for=\"mobileSortSelect\">Sort by:<\/label>\n  <div class=\"mobile-sort__select-wrap\">\n    <select id=\"mobileSortSelect\" class=\"mobile-sort__select\" aria-label=\"Sort collections\">\n     \n\n      <!-- Options (use absolute URLs for safety) -->\n      <option value=\"https:\/\/guy-gee.myshopify.com\/collections\/most-popular\" data-path=\"\/collections\/most-popular\">Most Popular<\/option>\n      <option value=\"https:\/\/guy-gee.myshopify.com\/collections\/a-z\" data-path=\"\/collections\/a-z\">A-Z<\/option>\n      <option value=\"https:\/\/guy-gee.myshopify.com\/collections\/united-states\" data-path=\"\/collections\/united-states\">United States<\/option>\n      <option value=\"https:\/\/guy-gee.myshopify.com\/collections\/the-queen\" data-path=\"\/collections\/the-queen\">The Queen<\/option>\n    <\/select>\n  <\/div>\n<\/div>\n\n<style>\n \/* Make the dropdown reliably sit above product images on mobile *\/\n.mobile-sort {\n  display: block;\n  margin: 12px 0 16px;\n  position: relative;       \/* needed for z-index to apply *\/\n  z-index: 999999;          \/* higher than sticky media *\/\n  isolation: isolate;       \/* own stacking context *\/\n  overflow: visible;        \/* allow the menu to render outside *\/\n}\n\n@media (min-width: 750px) {\n  .mobile-sort { display: none; }\n}\n\n\/* Keep the wrapper and select in the same high layer *\/\n.mobile-sort__select-wrap,\n.mobile-sort__select {\n  position: relative;\n  z-index: 999999;\n}\n\n\/* If your product gallery uses a very high z-index, lower it slightly on mobile *\/\n@media (max-width: 749px) {\n  .product__media,\n  .product-gallery,\n  .product-media,\n  .product__media-wrapper {\n    z-index: 1;             \/* adjust selector to your theme if needed *\/\n  }\n}\n@media (max-width: 749px) {\n  .mobile-sort {\n    position: sticky;\n    top: 0;                 \/* or your header height if needed *\/\n    background: #fff;\n    padding-top: 8px;\n  }\n}\n@media (max-width: 749px) {\n  .section, .shopify-section, .container { \/* narrow to the actual wrapper if you can *\/\n    overflow: visible !important;\n  }\n}\n.mobile-sort__label {\nletter-spacing:3px;\n<\/style>\n\n<script>\n  (function() {\n    const root = document.querySelector('[data-mobile-sort]');\n    if (!root) return;\n    const select = root.querySelector('#mobileSortSelect');\n    if (!select) return;\n\n    \/\/ Normalise a path (strip trailing slash)\n    const normalisePath = (p) => {\n      try {\n        \/\/ If we got a full URL, convert to pathname\n        if (\/^https?:\\\/\\\/\/i.test(p)) {\n          return new URL(p).pathname.replace(\/\\\/+$\/, '') || '\/';\n        }\n      } catch (e) {}\n      return String(p || '').replace(\/\\\/+$\/, '') || '\/';\n    };\n\n    const currentPath = normalisePath(window.location.pathname);\n\n    \/\/ Try to match by data-path against the current location path\n    const options = Array.from(select.options);\n    let matchedIndex = -1;\n    options.forEach((opt, idx) => {\n      const path = normalisePath(opt.getAttribute('data-path') || '');\n      if (path !== '\/' && path !== '') {\n        \/\/ startsWith allows your custom domain to match the myshopify path\n        if (currentPath === path || currentPath.startsWith(path + '\/')) {\n          matchedIndex = idx;\n        }\n      }\n    });\n\n    if (matchedIndex > 0) {\n      select.selectedIndex = matchedIndex;\n    } else {\n      \/\/ Keep placeholder \"SORT BY\"\n      select.selectedIndex = 0;\n    }\n\n    \/\/ Navigate on change (ignore placeholder)\n    select.addEventListener('change', function() {\n      const val = this.value;\n      if (val) {\n        window.location.href = val;\n      } else {\n        \/\/ if user taps placeholder, do nothing\n        this.blur();\n      }\n    }, { passive: true });\n  })();\n<\/script>","spacing_desktop":50,"spacing_mobile":30,"fix_zindex":0}},"965cc171-3bf5-4f7c-b5de-dcced37badd4":{"type":"section-collection-list","custom_css":["{overflow: visible !important; margin-top: -80px;}","picture {display: none;}","ul.l4cl {display: flex !important; flex-wrap: wrap !important; justify-content: 