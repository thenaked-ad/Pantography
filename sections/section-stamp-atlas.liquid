          .call(zoom.transform, clampT(k, (b[0][0] + b[1][0]) / 2, (b[0][1] + b[1][1]) / 2));

        g.selectAll('.sa-country').classed('sa-selected', false).classed('sa-dim', true);
        if (el) d3.select(el).classed('sa-selected', true).classed('sa-dim', false);

        var name = d.properties.name;
        g.selectAll('.sa-dot,.sa-ring,.sa-label').classed('sa-inv', function (m) { return m._c === name; });

